{
  "name": "larbi-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API (Express + PostgreSQL) for the Larbi platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed:clean": "node prisma/seed.js --clean",
    "make-admin": "node scripts/make-admin.js",
    "pretest": "node tests/setup.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 \"tests/unit/**/*.test.js\" \"tests/functional/**/*.test.js\" \"tests/security/**/*.test.js\" \"tests/consistency/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:functional": "node tests/setup.js && node --test --test-reporter=spec --test-concurrency=1 \"tests/functional/**/*.test.js\"",
    "test:security": "node tests/setup.js && node --test --test-reporter=spec --test-concurrency=1 \"tests/security/**/*.test.js\"",
    "test:consistency": "node tests/setup.js && node --test --test-reporter=spec --test-concurrency=1 \"tests/consistency/**/*.test.js\"",
    "test:e2e": "node tests/setup.js && node --test --test-reporter=spec --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "check:consistency": "node scripts/check-consistency.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pg": "^8.23.0",
    "prisma": "^7.10.0"
  }
}
