NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://larbi:larbi_dev_password@localhost:5432/larbi_dev

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Secret used to sign session tokens (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
# Session lifetime in seconds (default: 7 days)
JWT_EXPIRES_IN_SECONDS=604800

# Private media storage directory (default: server/storage). Keep it outside any
# public web root; back it up together with the database.
# STORAGE_DIR=./storage
# Upload size limits in bytes (defaults: image 5 MB, document 25 MB, video 300 MB)
# MAX_IMAGE_BYTES=5242880
# MAX_DOCUMENT_BYTES=26214400
# MAX_VIDEO_BYTES=314572800

# Public certificate verification: max requests per minute per IP (default: 30)
# CERTIFICATE_RATE_LIMIT=30

# Protected media (lesson files, covers), limits per ACCOUNT (defaults shown)
# MEDIA_RATE_LIMIT=300      requests per minute
# MEDIA_DENIED_LIMIT=30     refused/failed requests per 10 minutes before a 429

# Other abuse limits (defaults shown)
# AUTH_RATE_LIMIT=20         login / registration attempts per 15 minutes per address
# CONTACT_RATE_LIMIT=5       contact messages per hour per address
# PUBLIC_READ_LIMIT=240      public blog reads per minute per address

# Newsletter (P3-05). No e-mail provider is chosen yet, so no real mail can be sent:
#   MAIL_DRIVER=console  development: mails are printed in the server log (nothing leaves the machine)
#   MAIL_DRIVER=none     default in production: the newsletter answers "not available" instead of pretending
# MAIL_DRIVER=console
# PUBLIC_URL=http://localhost:5173   address of the website, written in the links of e-mails
# NEWSLETTER_RATE_LIMIT=5            sign-ups per hour per address (mail bombing)
# NEWSLETTER_LINK_RATE_LIMIT=30      confirmation / unsubscription clicks per minute per address

# Access log: one line per request (default: on; always off when NODE_ENV=test)
# LOG_REQUESTS=false
