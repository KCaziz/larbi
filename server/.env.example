NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://larbi:larbi_dev_password@localhost:5432/larbi_dev

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Secret used to sign session tokens (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
# Session lifetime in seconds (default: 7 days)
JWT_EXPIRES_IN_SECONDS=604800

# Private media storage directory (default: server/storage). Keep it outside any
# public web root; back it up together with the database.
# STORAGE_DIR=./storage
# Upload size limits in bytes (defaults: image 5 MB, document 25 MB, video 300 MB)
# MAX_IMAGE_BYTES=5242880
# MAX_DOCUMENT_BYTES=26214400
# MAX_VIDEO_BYTES=314572800
