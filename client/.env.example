# Optional. Leave unset to use the same-origin `/api` (Vite proxy in dev,
# reverse proxy in production) — recommended, it keeps the session cookie
# first-party. Only set this to reach an API on another origin.
# VITE_API_URL=http://localhost:4000/api

# Development only (read by vite.config.js, never by the application code).
#
# Where the dev server forwards /api. Leave unset for the local backend.
# VITE_API_PROXY=http://localhost:4000
#
# Only when sharing the dev server through a tunnel (ngrok, localtunnel): the
# browser arrives on the tunnel's port 443, not on Vite's local port, so the
# hot-reload client must aim at 443. Leave UNSET locally — port 443 does not
# listen there, the WebSocket never connects and the console fills with errors.
# VITE_HMR_CLIENT_PORT=443
